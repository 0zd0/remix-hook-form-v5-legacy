{
    "name": "remix-hook-form-v5-legacy",
    "$schema": "node_modules/nx/schemas/project-schema.json",
    "targets": {
        "eslint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "src/**/*.ts",
                    "src/**/*.tsx"
                ]
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run"
            }
        },
        "ts": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc"
            }
        },
        "prettier": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier ./src --check"
            }
        },
        "pre-commit": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "nx run-many --target=prettier",
                    "nx run-many --target=eslint",
                    "nx run-many --target=test",
                    "nx run-many --target=ts"
                ],
                "parallel": true
            }
        }
    }
}